GROQ_API_KEY=aquiVaLaClaveDeAPIdelLLM

FLASK_SECRET_KEY=la_clave_que_genera_el_comando
comando == python -c "import secrets; print(secrets.token_hex(32))"

# Cuenta de profesor inicial. Solo se usa para sembrar la base de datos
# de usuarios (data/usuarios.db) la primera vez que arranca la app.
USUARIO_PROFESOR=usuario_deseado
CONTRASENA_PROFESOR=contrasenya_deseada

# Servidor SMTP para enviar los códigos de la verificación en dos pasos.
# SIN esta configuración el inicio de sesión queda bloqueado (no hay
# forma de entregar el código). Para pruebas puedes usar Mailtrap:
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASSWORD=tu_contrasena_smtp
SMTP_FROM=no-reply@asistente-fp.local
# SMTP_TLS=true    # usa STARTTLS (por defecto). El puerto 465 usa SSL directo.


