# Entorno virtual y caché de Python
venv/
__pycache__/
*.pyc

# Secretos — nunca se suben
.env

# Datos generados/vivos en la VM — Git solo gestiona código,
# no la base vectorial ni las bases de datos en producción
data/

# Documentos originales (PDFs) — pesan mucho y ya están en la VM
documents/
.DS_Store
